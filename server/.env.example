# Sao chép file này thành server/.env rồi điền giá trị.

PORT=8787

# Chuỗi bí mật dài, ngẫu nhiên để ký phiên đăng nhập. Ví dụ tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 1 = cho phép đăng nhập thử bằng mã tự đặt khi chạy trên trình duyệt máy tính.
# BẮT BUỘC đặt 0 khi chạy thật.
DEV_LOGIN=1

# App Secret của Zalo Mini App (trang Quản lý ứng dụng), dùng để xác thực người dùng.
ZALO_APP_SECRET=

# Mã đăng nhập trang quản trị /admin. Để trống = khóa trang quản trị.
ADMIN_KEY=

# Tên miền được phép gọi API (tên miền của Mini App). * = cho phép tất cả khi chạy thử.
CORS_ORIGIN=*

# Số khu và số người tối đa mỗi khu
KHU_COUNT=8
KHU_CAPACITY=100

# Đặt 1 khi chạy sau Caddy/Nginx (gói Docker), để lấy đúng IP người chơi từ X-Forwarded-For.
TRUST_PROXY=0
# Số lần đăng nhập tối đa mỗi phút cho một IP (nhiều người dùng chung wifi trường, phường).
AUTH_PER_MIN=120

# Đấu phòng Gian 1, Gian 2: số người tối thiểu để bắt đầu, tối đa mỗi phòng, đếm ngược khi đủ người (mili giây)
MATCH_MIN=20
MATCH_MAX=50
MATCH_COUNTDOWN=15000
